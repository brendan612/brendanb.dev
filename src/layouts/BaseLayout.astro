---
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import CursorTrail from '../components/site/CursorTrail.astro';
import { site } from '../consts/site';
import { accents, defaultAccent } from '../consts/themes';
import '../styles/global.css';
import geistFont from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url';
import monoFont from '@fontsource/jetbrains-mono/files/jetbrains-mono-latin-400-normal.woff2?url';
import pixelFont from '@fontsource/silkscreen/files/silkscreen-latin-400-normal.woff2?url';
interface Props { title?: string; description?: string; }
const { title = `${site.name} — Portfolio`, description = site.description } = Astro.props;
---
<!doctype html>
<html lang="en">
 <head>
  <script is:inline define:vars={{ accentIds: accents.map(({ id }) => id), defaultAccent }}>
   const root = document.documentElement;
   root.dataset.theme = 'dark';
   root.dataset.accent = defaultAccent;
   try {
    root.dataset.theme = localStorage.getItem('theme') === 'light' ? 'light' : 'dark';
    const savedAccent = localStorage.getItem('accent');
    if (accentIds.includes(savedAccent)) root.dataset.accent = savedAccent;
   } catch { /* Defaults remain usable when storage is unavailable. */ }
  </script>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <meta name="description" content={description} />
  <link rel="preload" href={geistFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={monoFont} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={pixelFont} as="font" type="font/woff2" crossorigin />
  <link rel="icon" type="image/png" href="/logo.png" />
  <title>{title}</title>
 </head>
 <body>
  <a class="skip-link" href="#main">Skip to content</a>
  <CursorTrail />
  <Header />
  <main id="main"><slot /></main>
  <Footer />
  <script>
   const code = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
   let progress = 0;
   let celebrating = false;
   document.addEventListener('keydown', (event) => {
    if ((event.target as HTMLElement)?.closest('input, textarea, select, [contenteditable]')) return;
    const key = event.key.length === 1 ? event.key.toLowerCase() : event.key;
    progress = key === code[progress] ? progress + 1 : key === code[0] ? 1 : 0;
    if (progress !== code.length || celebrating) return;
    progress = 0;
    celebrating = true;
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
     const palette = ['var(--accent)', 'var(--ok)', 'var(--ink-strong)'];
     for (let i = 0; i < 24; i++) {
      const bit = document.createElement('div');
      bit.className = 'confetti-bit';
      bit.style.left = `${Math.random() * 100}vw`;
      bit.style.background = palette[i % palette.length];
      bit.style.setProperty('--fall-time', `${1.1 + Math.random()}s`);
      document.body.appendChild(bit);
      setTimeout(() => bit.remove(), 2400);
     }
    }
    const toast = document.createElement('div');
    toast.className = 'cheat-toast';
    toast.setAttribute('role', 'status');
    toast.textContent = 'You found a little surprise. Thanks for visiting!';
    document.body.appendChild(toast);
    setTimeout(() => { toast.remove(); celebrating = false; }, 3000);
   });
  </script>
 </body>
</html>
<style>
 main { position:relative; z-index:1; min-height:60vh; }
 :global(.footer) { position:relative; z-index:1; }
 .skip-link { position:fixed; top:1rem; left:1rem; z-index:200; transform:translateY(-200%); padding:.6rem 1rem; background:var(--bg-elev); color:var(--accent); border:1px solid var(--accent); border-radius:6px; }
 .skip-link:focus { transform:none; }
</style>
