---
import { site } from '../../consts/site';
---
<section class="hero container">
 <div class="intro animate-fade-up">
  <p class="eyebrow hud-label"><span aria-hidden="true">✦</span> Software engineer & creative problem solver</p>
  <h1>Brendan<br /><span>Bishop<span class="name-dot">.</span></span></h1>
  <p class="tagline">Useful by day.<br />A little more playful after hours.</p>
  <p class="description">I build web apps, games, and tools that make life a little better. Based in {site.location}.</p>
  <div class="actions">
   <a href="/projects" class="btn btn-primary"><span class="play" aria-hidden="true">▶</span> Explore my projects</a>
   <a href="/about" class="about-link">About me <span aria-hidden="true">↗</span></a>
  </div>
 </div>
 <aside class="overworld animate-fade-up animate-delay-2" aria-label="Current side project">
  <div class="map-header"><span class="hud-label">Somewhere after hours</span><span class="map-star" aria-hidden="true">✧</span></div>
  <svg class="world" viewBox="0 0 320 260" fill="none" aria-hidden="true" shape-rendering="crispEdges">
   <!-- A tiny overworld: stepping stones lead to the next build. -->
   <g fill="var(--line)"><path d="M40 190h16v4H40zm230-144h4v4h-4zM75 62h4v4h-4zm185 162h4v4h-4zM42 125h4v4h-4zm178-97h4v4h-4z"/><path d="M80 171h16v4H80zm132 42h20v4h-20zM54 79h12v4H54z"/></g>
   <path d="M80 154h20v-18h40v-18h72v18h30v20h22v38h-24v18H108v-16H80z" fill="var(--surface-strong)"/>
   <path d="M80 154h20v-18h40v-18h72v18h30v20h22v24h-24v18H108v-16H80z" fill="var(--surface)" stroke="var(--line-strong)"/>
   <path d="M132 191v-19h31v-19h35v-26" stroke="var(--accent-deep)" stroke-width="7" stroke-dasharray="6 7"/>
   <g fill="var(--ok-deep)"><path d="M95 143v-10h7v-9h7v9h7v10h7v7H88v-7z"/><path d="M230 175v-9h6v-9h6v9h6v9h6v7h-30v-7z"/><path d="M120 113v-9h6v-9h6v9h6v9h6v7h-30v-7z"/></g>
   <g fill="var(--ok)"><path d="M102 133v-9h7v9h7v4h-21v-4z"/><path d="M236 166v-9h6v9h6v4h-18v-4z"/><path d="M126 104v-9h6v9h6v4h-18v-4z"/></g>
   <path d="M180 125V87h10v10h10V87h10v38z" fill="var(--accent-deep)"/>
   <path d="M184 122v-23h22v23z" fill="var(--accent)"/><path d="M191 122v-13h8v13z" fill="var(--bg)"/>
   <path d="M195 86V63h22v12h-18" stroke="var(--accent)" stroke-width="4"/>
   <path d="M134 156h8v8h-8z" fill="var(--ink-strong)"/><path d="M131 165h14v10h-14z" fill="var(--accent)"/><path d="M132 175h4v5h-4zm8 0h4v5h-4z" fill="var(--ink-strong)"/>
   <path d="M169 45h4v4h4v4h-4v4h-4v-4h-4v-4h4z" fill="var(--accent)" opacity=".7"/>
  </svg>
  <a class="current-project" href="/projects/idle-game/">
   <span class="current-label"><span class="status" data-status="in-progress">Currently building</span><strong>Untitled Idle Game</strong></span>
   <span class="current-arrow" aria-hidden="true">↗</span>
  </a>
 </aside>
 <div class="hero-bottom"><span class="hud-label">A small corner of the internet. Made for exploring.</span><a href="#selected-projects" class="scroll-link">See my work <span aria-hidden="true">↓</span></a></div>
</section>
<style>
 .hero { padding-top:clamp(3rem,7vw,6.5rem); display:grid; grid-template-columns:1.3fr 1fr; align-items:center; gap:2rem 4rem; }
 .eyebrow { margin-bottom:1.6rem; font-size:.66rem; letter-spacing:.06em; }
 .eyebrow span { color:var(--accent); margin-right:.4rem; }
 h1 { color:var(--ink-strong); font-size:clamp(3.5rem,6.6vw,5.8rem); line-height:1.04; letter-spacing:-.065em; font-weight:550; }
 h1 > span { font-family:var(--font-pixel); font-size:.82em; font-weight:400; letter-spacing:-.06em; color:var(--accent); }
 .name-dot { color:var(--ok); }
 .tagline { margin-top:1.7rem; color:var(--ink-strong); font-size:clamp(1.2rem,1.7vw,1.5rem); line-height:1.45; letter-spacing:-.025em; }
 .description { color:var(--muted); max-width:43ch; margin-top:.85rem; font-size:.98rem; line-height:1.8; }
 .actions { display:flex; flex-wrap:wrap; align-items:center; gap:1.5rem; margin-top:1.8rem; }
 .play { font-size:.6rem; }
 .about-link { font-size:.83rem; color:var(--muted); }
 .about-link span { margin-left:.4rem; color:var(--accent); }
 .about-link:hover { color:var(--ink-strong); }
 .overworld { border:1px solid var(--line); border-radius:16px; background:color-mix(in srgb,var(--bg-elev) 80%,transparent); margin-top:1rem; overflow:hidden; }
 .map-header { display:flex; justify-content:space-between; align-items:center; padding:1.2rem 1.5rem 0; }
 .map-header .hud-label { font-size:.58rem; }
 .map-star { color:var(--accent); font-size:1.15rem; }
 .world { display:block; width:100%; height:auto; max-height:310px; }
 .current-project { display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--line); padding:1.1rem 1.5rem; background:var(--bg-elev); transition:background var(--transition-fast); }
 .current-label { display:flex; flex-direction:column; gap:.25rem; }
 .current-label strong { color:var(--ink-strong); font-size:.95rem; font-weight:500; }
 .current-arrow { color:var(--muted); }
 .current-project:hover { background:var(--surface); }
 .current-project:hover .current-arrow { color:var(--accent); }
 .hero-bottom { grid-column:1 / -1; display:flex; justify-content:space-between; gap:1rem; padding:2rem 0 1.8rem; margin-top:2rem; border-bottom:1px solid var(--line); }
 .hero-bottom .hud-label { font-size:.59rem; text-transform:none; letter-spacing:0; }
 .scroll-link { font:.65rem var(--font-mono); color:var(--muted); }
 .scroll-link span { color:var(--accent); margin-left:.6rem; }
 @media (max-width:760px) {
  .hero { grid-template-columns:1fr; gap:2.5rem; padding-top:3rem; }
  h1 { font-size:clamp(3.2rem,12vw,5rem); }
  .overworld { margin:0; width:100%; }
  .world { max-height:230px; }
  .hero-bottom { margin:0; padding-top:0; }
  .hero-bottom > .hud-label { max-width:25ch; }
  .scroll-link { align-self:center; white-space:nowrap; }
 }
</style>
