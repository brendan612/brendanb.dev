---
import { site } from '../../consts/site';
---

<section class="hero" data-hero>
	<div class="container hero-inner">
		<!-- HUD strip -->
		<div class="hud animate-fade-up animate-delay-1">
			<span class="hud-chip">
				<span class="hud-label is-accent">LV {site.age}</span>
			</span>
			<span class="hud-chip hud-xp" title="XP to next level — one level per year">
				<span class="hud-label">XP</span>
				<span class="xp-track" role="img" aria-label="Experience bar">
					<span class="xp-fill" data-xp-fill></span>
				</span>
				<span class="hud-label" data-xp-pct>—</span>
			</span>
			<span class="hud-chip">
				<span class="hud-label">{site.location}</span>
			</span>
			<span class="hud-chip is-online">
				<span class="hud-label">● online</span>
			</span>
		</div>

		<!-- Title -->
		<h1 class="title animate-fade-up animate-delay-2">
			<span class="title-line">Brendan</span>
			<span class="title-line is-accent">Bishop</span>
		</h1>

		<p class="tagline animate-fade-up animate-delay-3">
			Software engineer. I ship web apps by day and build games,
			tools, and experiments after hours.
		</p>

		<!-- Title-screen menu — drivable with ↑ ↓ + Enter -->
		<nav class="menu animate-fade-up animate-delay-4" aria-label="Main menu" data-menu>
			<a href="/projects" class="menu-item is-selected" data-menu-item>
				<span class="menu-cursor" aria-hidden="true">▶</span>
				<span class="menu-label">Projects</span>
				<span class="menu-sub">the quest log</span>
			</a>
			<a href="/about" class="menu-item" data-menu-item>
				<span class="menu-cursor" aria-hidden="true">▶</span>
				<span class="menu-label">About</span>
				<span class="menu-sub">character sheet</span>
			</a>
			<a href="/contact" class="menu-item" data-menu-item>
				<span class="menu-cursor" aria-hidden="true">▶</span>
				<span class="menu-label">Contact</span>
				<span class="menu-sub">party up</span>
			</a>
		</nav>

		<p class="hint hud-label animate-fade-up animate-delay-5" data-menu-hint>
			<span class="hint-keys">↑ ↓</span> select&ensp;·&ensp;<span class="hint-keys">enter</span> confirm
			<span class="hint-caret" aria-hidden="true">_</span>
		</p>
	</div>
</section>

<script>
	// ── XP bar: progress through the current year (one level per year) ──
	const fill = document.querySelector<HTMLElement>('[data-xp-fill]');
	const pctEl = document.querySelector<HTMLElement>('[data-xp-pct]');
	if (fill && pctEl) {
		const now = new Date();
		const start = new Date(now.getFullYear(), 0, 1).getTime();
		const end = new Date(now.getFullYear() + 1, 0, 1).getTime();
		const pct = Math.round(((now.getTime() - start) / (end - start)) * 100);
		pctEl.textContent = `${pct}%`;
		requestAnimationFrame(() => {
			fill.style.width = `${pct}%`;
		});
	}

	// ── Title-screen menu: ↑ ↓ + Enter while the hero is on screen ──
	const hero = document.querySelector<HTMLElement>('[data-hero]');
	const items = Array.from(document.querySelectorAll<HTMLAnchorElement>('[data-menu-item]'));

	if (hero && items.length) {
		let selected = 0;
		let heroVisible = true;

		const select = (i: number) => {
			selected = (i + items.length) % items.length;
			items.forEach((el, j) => el.classList.toggle('is-selected', j === selected));
		};

		items.forEach((el, i) => {
			el.addEventListener('mouseenter', () => select(i));
			el.addEventListener('focus', () => select(i));
		});

		const io = new IntersectionObserver(
			([entry]) => {
				heroVisible = entry.intersectionRatio > 0.45;
			},
			{ threshold: [0, 0.45, 1] }
		);
		io.observe(hero);

		document.addEventListener('keydown', (e) => {
			if (!heroVisible) return;
			const t = e.target as HTMLElement | null;
			if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;

			if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
				e.preventDefault();
				select(selected + (e.key === 'ArrowDown' ? 1 : -1));
			} else if (e.key === 'Enter') {
				// don't steal Enter from focused links/buttons elsewhere
				if (t && t.closest('a, button') && !t.closest('[data-menu]')) return;
				e.preventDefault();
				items[selected].click();
			}
		});
	}
</script>

<style>
	.hero {
		position: relative;
		padding: var(--space-16) 0 var(--space-12);
		min-height: min(82vh, 52rem);
		display: flex;
		align-items: center;
	}

	.hero-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		width: 100%;
	}

	/* ── HUD strip ── */
	.hud {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.45rem;
		margin-bottom: var(--space-8);
	}

	.hud-chip {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.35rem 0.7rem;
		border: var(--border-w) solid var(--line);
		border-radius: 999px;
		background: color-mix(in oklab, var(--bg-elev) 88%, transparent);
	}

	.hud-chip.is-online .hud-label {
		color: var(--ok);
	}

	.xp-track {
		display: inline-block;
		width: 7.5rem;
		height: 0.55rem;
		border: var(--border-w) solid var(--line-strong);
		border-radius: 999px;
		background: var(--bg);
		overflow: hidden;
	}

	.xp-fill {
		display: block;
		height: 100%;
		width: 0%;
		border-radius: 999px;
		background: linear-gradient(90deg, var(--accent-deep), var(--accent), var(--accent-strong));
		transition: width 1200ms 300ms var(--ease-out-expo);
	}

	/* ── Title — arcade marquee with chunky drop ── */
	.title {
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 0.98;
		display: flex;
		flex-direction: column;
		margin-bottom: var(--space-5);
	}

	.title-line {
		font-size: clamp(3rem, 1.8rem + 7.5vw, 7.2rem);
		color: var(--ink-strong);
		text-shadow:
			0.045em 0.045em 0 var(--accent-deep),
			0.09em 0.09em 0 color-mix(in oklab, var(--accent-deep) 45%, transparent);
	}

	.title-line.is-accent {
		color: var(--accent);
		text-shadow:
			0.045em 0.045em 0 var(--accent-deep),
			0.09em 0.09em 0 color-mix(in oklab, var(--accent-deep) 45%, transparent);
	}

	/* ── Tagline ── */
	.tagline {
		font-size: clamp(0.98rem, 0.9rem + 0.4vw, 1.15rem);
		color: var(--muted);
		line-height: 1.6;
		max-width: 44ch;
		margin-bottom: var(--space-10);
	}

	/* ── Menu ── */
	.menu {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		min-width: min(24rem, 100%);
	}

	.menu-item {
		display: grid;
		grid-template-columns: 1.4rem auto 1fr;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.7rem 1.1rem;
		border: var(--border-w) solid transparent;
		border-radius: var(--radius-sm);
		text-align: left;
		transition:
			border-color var(--transition-fast),
			background var(--transition-fast),
			transform var(--transition-bounce);
	}

	.menu-cursor {
		font-size: 0.75rem;
		color: var(--accent);
		opacity: 0;
		transform: translateX(-6px);
		/* Don't transition opacity — fights blink/selection and causes flicker */
		transition: transform var(--transition-bounce);
	}

	.menu-label {
		font-family: var(--font-display);
		font-size: clamp(1.15rem, 1rem + 0.9vw, 1.6rem);
		color: var(--muted);
		transition: color var(--transition-fast);
	}

	.menu-sub {
		font-family: var(--font-hud);
		font-size: 0.6rem;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		color: var(--muted-soft);
		justify-self: end;
	}

	.menu-item.is-selected {
		border-color: var(--line-strong);
		background: color-mix(in oklab, var(--bg-elev) 85%, transparent);
		transform: translateX(4px);
	}

	.menu-item.is-selected .menu-cursor {
		opacity: 1;
		transform: translateX(0);
	}

	.menu-item.is-selected .menu-label {
		color: var(--ink-strong);
	}

	/* ── Hint ── */
	.hint {
		margin-top: var(--space-8);
		color: var(--muted-soft);
	}

	.hint-keys {
		color: var(--accent-strong);
	}

	.hint-caret {
		animation: blink 1.1s ease-in-out infinite;
		color: var(--accent);
	}

	/* ── Mobile ── */
	@media (max-width: 720px) {
		.hero {
			min-height: auto;
			padding: var(--space-12) 0 var(--space-8);
		}

		.hint {
			display: none;
		}

		.menu {
			width: 100%;
		}

		.menu-item {
			border-color: var(--line);
		}
	}
</style>
