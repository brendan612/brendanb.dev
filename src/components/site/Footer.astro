---
import { site } from '../../consts/site';

const year = new Date().getFullYear();
---

<footer class="footer">
	<div class="container inner">
		<div class="left">
			<span class="save-indicator">
				<span class="save-dot" aria-hidden="true"></span>
				<span class="hud-label">Thanks for stopping by</span>
			</span>
			<span class="copyright hud-label">&copy; {year} {site.name}</span>
		</div>

		<div class="right">
			<a href={site.github} target="_blank" rel="noreferrer" class="footer-link">
				<span class="hud-label">GitHub</span>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>
			<a href={`mailto:${site.email}`} class="footer-link">
				<span class="hud-label">Email</span>
				<span class="arrow" aria-hidden="true">↗</span>
			</a>
			<span class="credits hud-label" title="↑ ↑ ↓ ↓ ← → ← → B A">
				Built by Brendan
			</span>
		</div>
	</div>
</footer>

<style>
	.footer {
		margin-top: var(--space-6);
		padding: var(--space-6) 0 var(--space-8);
		border-top: var(--border-w) solid var(--line);
	}

	.inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.left {
		display: flex;
		align-items: center;
		gap: 1.5rem;
		flex-wrap: wrap;
	}

	.save-indicator {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
	}

	.save-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 2px;
		background: var(--ok);

	}

	@keyframes savePulse {
		0%, 100% { opacity: 1; box-shadow: 0 0 6px color-mix(in oklab, var(--ok) 55%, transparent); }
		50% { opacity: 0.4; box-shadow: none; }
	}

	.copyright {
		color: var(--muted-soft);
	}

	.right {
		display: flex;
		align-items: center;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.footer-link {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		color: var(--muted);
		transition: color var(--transition-fast);
	}

	.footer-link .hud-label {
		color: inherit;
	}

	.footer-link:hover,
	.footer-link:focus-visible {
		color: var(--accent-strong);
	}

	.arrow {
		font-size: 0.75rem;
		opacity: 0;
		transform: translateX(-4px);
		transition: opacity var(--transition-fast), transform var(--transition-fast);
	}

	.footer-link:hover .arrow,
	.footer-link:focus-visible .arrow {
		opacity: 1;
		transform: translateX(0);
	}

	.credits {
		color: var(--muted-soft);
		opacity: 0.65;
		cursor: help;
	}

	@media (max-width: 720px) {
		.credits {
			display: none;
		}
	}
</style>
