---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';

---

<header class="header-wrap">
	<div class="container header">
		<a href="/" class="brand" aria-label="Home">
			<span class="brand-logo"><img src="/logo.png" width="44" height="44" alt="" /></span>
			<span class="brand-text">
				<span class="brand-name">Brendan Bishop</span>
				<span class="brand-meta hud-label">software engineer</span>
			</span>
		</a>

		<nav class="nav" aria-label="Primary">
			<NavLink href="/" label="Home" />
			<NavLink href="/projects" label="Projects" />
			<NavLink href="/about" label="About" />
			<NavLink href="/contact" label="Contact" />
		</nav>

		<div class="header-right">
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.header-wrap {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: var(--border-w) solid color-mix(in oklab, var(--line) 85%, transparent);
		background: color-mix(in oklab, var(--bg) 84%, transparent);
		backdrop-filter: blur(14px) saturate(1.15);
		-webkit-backdrop-filter: blur(14px) saturate(1.15);
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 1.15rem 0;
		gap: var(--space-4);
	}

	/* ── Brand ── */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.brand-logo {
		display: inline-grid;
		place-items: center;
		width: 44px;
		height: 44px;
		flex-shrink: 0;
		background: #151923;
		border-radius: 8px;
	}


	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
		gap: 0.2rem;
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: 0.95rem;
		font-weight: 600;
		color: var(--ink-strong);
		letter-spacing: 0.01em;
	}

	.brand-meta {
		font-size: 0.58rem;
		color: var(--muted-soft);
	}

	/* ── Navigation ── */
	.nav {
		display: flex;
		gap: 0.2rem;
		flex-wrap: wrap;
	}

	/* Header controls */
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	@media (max-width: 720px) {
		.header {
			padding: 0.65rem 0;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			gap: 0.55rem var(--space-4);
		}

		.brand {
			grid-column: 1;
			grid-row: 1;
		}

		.header-right {
			grid-column: 2;
			grid-row: 1;
		}

		.nav {
			grid-column: 1 / -1;
			grid-row: 2;
		}
	}
</style>
