---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { site } from '../../consts/site';
---

<header class="header-wrap">
	<div class="container header">
		<a href="/" class="brand" aria-label="Home">
			<span class="brand-gem" aria-hidden="true">
				<svg width="20" height="20" viewBox="0 0 12 12" aria-hidden="true">
					<!-- pixel gem -->
					<rect x="3" y="1" width="6" height="2" fill="var(--accent-strong)"/>
					<rect x="1" y="3" width="10" height="2" fill="var(--accent)"/>
					<rect x="2" y="5" width="8" height="2" fill="var(--accent)"/>
					<rect x="3" y="7" width="6" height="2" fill="var(--accent-deep)"/>
					<rect x="5" y="9" width="2" height="2" fill="var(--accent-deep)"/>
					<rect x="3" y="3" width="2" height="2" fill="var(--accent-strong)"/>
				</svg>
			</span>
			<span class="brand-text">
				<span class="brand-name">Brendan Bishop</span>
				<span class="brand-meta hud-label">software engineer</span>
			</span>
		</a>

		<nav class="nav" aria-label="Primary">
			<NavLink href="/" label="Home" />
			<NavLink href="/projects" label="Projects" />
			<NavLink href="/about" label="About" />
			<NavLink href="/contact" label="Contact" />
		</nav>

		<div class="header-right">
			<span class="lv-badge" title={`Level ${site.age} — one level per year`}>
				<span class="hud-label is-accent">LV {site.age}</span>
			</span>
			<ThemeToggle />
		</div>
	</div>
</header>

<style>
	.header-wrap {
		position: sticky;
		top: 0;
		z-index: 100;
		border-bottom: var(--border-w) solid color-mix(in oklab, var(--line) 85%, transparent);
		background: color-mix(in oklab, var(--bg) 84%, transparent);
		backdrop-filter: blur(14px) saturate(1.15);
		-webkit-backdrop-filter: blur(14px) saturate(1.15);
	}

	.header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.75rem 0;
		gap: var(--space-4);
	}

	/* ── Brand ── */
	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
	}

	.brand-gem {
		display: inline-grid;
		place-items: center;
		transition: transform var(--transition-bounce);
	}

	.brand:hover .brand-gem {
		transform: translateY(-2px) rotate(-8deg) scale(1.1);
	}

	.brand-text {
		display: flex;
		flex-direction: column;
		line-height: 1;
		gap: 0.2rem;
	}

	.brand-name {
		font-family: var(--font-display);
		font-size: 0.85rem;
		color: var(--ink-strong);
		letter-spacing: 0.01em;
	}

	.brand-meta {
		font-size: 0.54rem;
		color: var(--muted-soft);
	}

	/* ── Navigation ── */
	.nav {
		display: flex;
		gap: 0.2rem;
		flex-wrap: wrap;
	}

	/* ── Level badge ── */
	.header-right {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	.lv-badge {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.65rem;
		border: var(--border-w) solid var(--tag-border);
		border-radius: 999px;
		background: var(--tag-bg);
	}

	@media (max-width: 720px) {
		.header {
			padding: 0.65rem 0;
			display: grid;
			grid-template-columns: 1fr auto;
			grid-template-rows: auto auto;
			gap: 0.55rem var(--space-4);
		}

		.brand {
			grid-column: 1;
			grid-row: 1;
		}

		.header-right {
			grid-column: 2;
			grid-row: 1;
		}

		.nav {
			grid-column: 1 / -1;
			grid-row: 2;
		}

		.lv-badge {
			display: none;
		}
	}
</style>
