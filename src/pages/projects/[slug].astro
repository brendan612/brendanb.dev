---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site } from '../../consts/site';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { slug: project.slug },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);

const QUEST_LABEL: Record<string, string> = {
	live: 'quest complete',
	'in-progress': 'quest active',
	archived: 'quest retired',
};
---

<BaseLayout title={`${project.data.title} | ${site.name}`}>
	<article class="container article">
		<!-- Back link -->
		<p class="back-row animate-fade-up animate-delay-1">
			<a class="back" href="/projects">
				<span class="back-arrow" aria-hidden="true">◀</span>
				<span class="hud-label">Back to save files</span>
			</a>
		</p>

		<!-- Quest header -->
		<header class="quest-head animate-fade-up animate-delay-2">
			<div class="head-row">
				<span class="status" data-status={project.data.status}>
					{QUEST_LABEL[project.data.status]}
				</span>
				<span class="quest-date hud-label">
					saved {project.data.date.toLocaleDateString('en-US', {
						month: 'short',
						year: 'numeric',
					})}
				</span>
			</div>

			<h1 class="quest-title">{project.data.title}</h1>
			<p class="quest-summary lede">{project.data.summary}</p>

			<div class="loot-row">
				<span class="loot-label hud-label" aria-hidden="true">Built with</span>
				{project.data.tags.map((tag: string) => (
					<span class="chip">{tag}</span>
				))}
			</div>
		</header>

		<!-- Links -->
		{(project.data.liveUrl || project.data.repoUrl) && (
			<div class="links animate-fade-up animate-delay-3">
				{project.data.liveUrl && (
					<a href={project.data.liveUrl} target="_blank" rel="noreferrer" class="btn btn-primary">
						Play live
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				)}
				{project.data.repoUrl && (
					<a href={project.data.repoUrl} target="_blank" rel="noreferrer" class="btn btn-ghost">
						View source
						<span class="arrow" aria-hidden="true">↗</span>
					</a>
				)}
			</div>
		)}

		<!-- Content -->
		<div class="content animate-fade-up animate-delay-4">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.article {
		padding-top: var(--space-12);
		max-width: 50rem;
	}

	/* ── Back ── */
	.back-row {
		margin-bottom: var(--space-8);
	}

	.back {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted);
		transition: color var(--transition-fast);
	}

	.back .hud-label {
		color: inherit;
	}

	.back:hover,
	.back:focus-visible {
		color: var(--accent-strong);
	}

	.back-arrow {
		font-size: 0.7rem;
		color: var(--accent);
		transition: transform var(--transition-bounce);
	}

	.back:hover .back-arrow {
		transform: translateX(-3px);
	}

	/* ── Quest header ── */
	.quest-head {
		display: flex;
		flex-direction: column;
		gap: var(--space-4);
		margin-bottom: var(--space-8);
		padding-bottom: var(--space-8);
		border-bottom: var(--border-w) solid var(--line);
	}

	.head-row {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.quest-date {
		color: var(--muted-soft);
	}

	.quest-title {
		font-family: var(--font-display);
		font-size: clamp(2rem, 1.4rem + 3.2vw, 4rem);
		font-weight: 400;
		line-height: 1.02;
		color: var(--ink-strong);
		margin: 0;
	}

	.quest-summary {
		color: var(--ink);
	}

	.loot-row {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.35rem;
	}

	.loot-label {
		color: var(--muted-soft);
		margin-right: 0.25rem;
	}

	/* ── Links ── */
	.links {
		display: flex;
		gap: 0.7rem;
		flex-wrap: wrap;
		margin: 0 0 var(--space-8);
	}

	/* ── Content ── */
	.content :global(p),
	.content :global(li) {
		color: var(--ink);
		line-height: 1.75;
	}

	.content :global(p + p) {
		margin-top: var(--space-4);
	}

	.content :global(ul),
	.content :global(ol) {
		margin: var(--space-4) 0;
		padding-left: 1.2rem;
	}

	.content :global(ul) {
		list-style: square;
	}

	.content :global(ol) {
		list-style: decimal;
	}

	.content :global(h2),
	.content :global(h3) {
		font-family: var(--font-display);
		font-weight: 400;
		line-height: 1.1;
		margin-top: var(--space-10);
		margin-bottom: var(--space-3);
		color: var(--ink-strong);
	}

	.content :global(h2) {
		font-size: 1.5rem;
	}

	.content :global(h3) {
		font-size: 1.15rem;
	}

	.content :global(code) {
		font-family: var(--font-mono);
		font-size: 0.86em;
		padding: 0.15em 0.4em;
		background: var(--tag-bg);
		border-radius: var(--radius-xs);
		color: var(--tag-fg);
	}

	.content :global(a) {
		color: var(--accent-strong);
		text-decoration: underline;
		text-decoration-color: color-mix(in oklab, var(--accent) 40%, transparent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.2em;
		transition: text-decoration-color var(--transition-fast);
	}

	.content :global(a:hover) {
		text-decoration-color: var(--accent);
	}
</style>
