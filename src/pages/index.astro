---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import { site } from '../consts/site';

const featuredProjects = (await getCollection('projects'))
	.filter((entry) => entry.data.featured)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title={`${site.name} | Home`}>
	<Hero />
	<FeaturedProjects projects={featuredProjects} />

	<!-- CTA — co-op invite -->
	<section class="container cta-section reveal">
		<div class="cta panel">
			<div class="cta-icon" aria-hidden="true">
				<svg width="44" height="44" viewBox="0 0 16 16">
					<!-- pixel heart -->
					<rect x="2" y="3" width="4" height="2" fill="var(--accent)"/>
					<rect x="10" y="3" width="4" height="2" fill="var(--accent)"/>
					<rect x="1" y="5" width="14" height="3" fill="var(--accent)"/>
					<rect x="2" y="8" width="12" height="2" fill="var(--accent)"/>
					<rect x="4" y="10" width="8" height="2" fill="var(--accent-deep)"/>
					<rect x="6" y="12" width="4" height="2" fill="var(--accent-deep)"/>
					<rect x="3" y="5" width="2" height="2" fill="var(--accent-strong)"/>
				</svg>
			</div>

			<p class="hud-label is-accent">2-player mode</p>
			<h2 class="section-title cta-heading">
				Got a project?<br />Let's <span class="accent">party up.</span>
			</h2>
			<p class="lede cta-desc">
				I like building polished interfaces, useful tools, and the occasional
				game. Tell me what you're making — I read everything.
			</p>

			<div class="cta-actions">
				<a class="btn btn-primary" href="/contact">
					Send invite
					<span class="arrow" aria-hidden="true">↗</span>
				</a>
				<a class="btn btn-ghost" href={`mailto:${site.email}`}>
					{site.email}
				</a>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.cta-section {
		padding: var(--space-12) 0 var(--space-20);
	}

	.cta {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding: var(--space-12) var(--space-8);
	}

	.cta-icon {
		margin-bottom: var(--space-4);
	}

	:global(.reveal.is-visible) .cta-icon {
		animation: popIn 500ms 250ms var(--ease-bounce) both;
	}

	.cta-heading {
		margin: 0.4rem 0 var(--space-3);
	}

	.cta-desc {
		max-width: 46ch;
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.7rem;
		margin-top: var(--space-8);
	}

	@media (max-width: 720px) {
		.cta {
			padding: var(--space-8) var(--space-5);
		}
	}
</style>
