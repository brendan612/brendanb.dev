---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import FeaturedProjects from '../components/home/FeaturedProjects.astro';
import { site } from '../consts/site';
const featuredProjects = (await getCollection('projects')).filter((entry) => entry.data.featured).sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
---
<BaseLayout title={`${site.name} | Home`}>
 <Hero />
 <FeaturedProjects projects={featuredProjects} />
</BaseLayout>
