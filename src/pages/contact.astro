---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../consts/site';
---

<BaseLayout title={`${site.name} | Contact`}>
	<section class="container section">
		<header class="page-head">
			<p class="hud-label is-accent">Contact</p>
			<h1 class="section-title">
				Let’s <span class="accent">talk.</span>
			</h1>
			<p class="lede">
				Email is the fastest way to reach me — I read everything and usually
				reply within a day or two.
			</p>
		</header>

		<div class="contact-layout">
			<!-- Primary: the invite -->
			<a
				href={`mailto:${site.email}`}
				class="invite panel"
			>
				<span class="invite-head">
					<span class="hud-label">Send me a message</span>
				</span>

				<span class="invite-body">
					<span class="invite-icon" aria-hidden="true">
						<svg width="52" height="52" viewBox="0 0 16 16">
							<!-- pixel envelope -->
							<rect x="1" y="3" width="14" height="10" fill="var(--surface-strong)" stroke="var(--line-strong)" stroke-width="0.75"/>
							<rect x="2" y="4" width="2" height="2" fill="var(--accent)"/>
							<rect x="4" y="6" width="2" height="2" fill="var(--accent)"/>
							<rect x="6" y="8" width="4" height="2" fill="var(--accent-strong)"/>
							<rect x="10" y="6" width="2" height="2" fill="var(--accent)"/>
							<rect x="12" y="4" width="2" height="2" fill="var(--accent)"/>
						</svg>
					</span>
					<span class="invite-mail">{site.email}</span>
				</span>

				<span class="invite-foot hud-label">
					Write me an email <span class="invite-arrow" aria-hidden="true">▶</span>
				</span>
			</a>

			<!-- Friend codes -->
			<div class="codes">
				<a href={site.github} target="_blank" rel="noreferrer" class="code panel">
					<span class="code-key hud-label">GitHub</span>
					<span class="code-val">@brendan612</span>
					<span class="code-arrow" aria-hidden="true">↗</span>
				</a>
				<a href={`mailto:${site.email}`} class="code panel">
					<span class="code-key hud-label">Email</span>
					<span class="code-val">{site.email}</span>
					<span class="code-arrow" aria-hidden="true">↗</span>
				</a>
				<div class="code panel is-static">
					<span class="code-key hud-label">Based in</span>
					<span class="code-val">{site.location} (PST)</span>
				</div>
				<div class="code panel is-static">
					<span class="code-key hud-label">Response time</span>
					<span class="code-val">Usually under 48h</span>
				</div>
			</div>
		</div>
	</section>
</BaseLayout>

<style>
	.section {
		padding: var(--space-16) 0 var(--space-16);
	}

	.page-head {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-bottom: var(--space-10);
	}

	.contact-layout {
		display: grid;
		grid-template-columns: 1.25fr 0.75fr;
		gap: var(--space-6);
		align-items: stretch;
	}

	/* ── Invite block ── */
	.invite {
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		padding: var(--space-6) var(--space-8);
		min-height: 19rem;
		transition:
			transform var(--transition-bounce),
			border-color var(--transition-fast),
			box-shadow var(--transition-bounce);
	}

	.invite:hover,
	.invite:focus-visible {
		transform: translateY(-1px);
		border-color: color-mix(in oklab, var(--accent) 50%, var(--line-strong));
		box-shadow: 0 calc(var(--chunk) + 3px) 0 var(--chunk-shadow), var(--shadow-soft);
	}

	.invite-head {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.invite-body {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-4);
		text-align: center;
	}

	.invite-icon {
		transition: transform var(--transition-bounce);
	}

	.invite:hover .invite-icon {
		transform: translateY(-4px) rotate(-4deg);
	}

	.invite-mail {
		font-family: var(--font-body);
		font-size: clamp(1.4rem, 1rem + 2.4vw, 2.6rem);
		line-height: 1.05;
		color: var(--ink-strong);
		word-break: break-word;
		transition: color var(--transition-fast);
	}

	.invite:hover .invite-mail {
		color: var(--accent-strong);
	}

	.invite-foot {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.5rem;
		color: var(--muted-soft);
	}

	.invite-arrow {
		color: var(--accent);
		transition: transform var(--transition-bounce);
	}

	.invite:hover .invite-arrow {
		transform: translateX(4px);
	}

	/* ── Friend codes ── */
	.codes {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.code {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.3rem;
		justify-content: center;
		padding: 0.95rem 1.15rem;
		flex: 1;
		transition:
			transform var(--transition-bounce),
			border-color var(--transition-fast),
			box-shadow var(--transition-bounce);
	}

	a.code:hover,
	a.code:focus-visible {
		transform: translateY(-2px);
		border-color: color-mix(in oklab, var(--accent) 50%, var(--line-strong));
		box-shadow: 0 calc(var(--chunk) + 2px) 0 var(--chunk-shadow);
	}

	.code-key {
		color: var(--muted-soft);
	}

	.code-val {
		font-size: 0.95rem;
		font-weight: 500;
		color: var(--ink-strong);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	a.code:hover .code-val {
		color: var(--accent-strong);
	}

	.code-arrow {
		position: absolute;
		top: 0.85rem;
		right: 1rem;
		font-family: var(--font-hud);
		font-size: 0.85rem;
		color: var(--muted-soft);
		transition: color var(--transition-fast), transform var(--transition-fast);
	}

	a.code:hover .code-arrow,
	a.code:focus-visible .code-arrow {
		color: var(--accent);
		transform: translate(2px, -2px);
	}

	/* ── Responsive ── */
	@media (max-width: 880px) {
		.contact-layout {
			grid-template-columns: 1fr;
		}

		.invite {
			min-height: 15rem;
		}
	}
</style>
