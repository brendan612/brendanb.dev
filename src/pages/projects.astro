---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../consts/site';

const projects = (await getCollection('projects')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const QUEST_LABEL: Record<string, string> = {
	live: 'Live',
	'in-progress': 'In progress',
	archived: 'Archived',
};
---

<BaseLayout
	title={`${site.name} | Projects`}
	description="Projects, games, and experiments by Brendan Bishop."
>
	<section class="container section">
		<header class="page-head animate-fade-up animate-delay-1">
			<p class="hud-label is-accent">Project library</p>
			<h1 class="section-title">
				Things I’ve <span class="accent">made.</span>
			</h1>
			<p class="lede">
				Every project on record — games, tools, and experiments, newest first.
			</p>
		</header>

		<ol class="slots">
			{
				projects.map((entry, i) => (
					<li
						class="slot-wrap animate-fade-up"
						style={`animation-delay: ${200 + i * 80}ms`}
					>
						<a href={`/projects/${entry.id}/`} class="slot panel">

							<span class="slot-main">
								<span class="slot-top">
									<h2 class="slot-title">{entry.data.title}</h2>
									<span class="status" data-status={entry.data.status}>
										{QUEST_LABEL[entry.data.status]}
									</span>
								</span>
								<span class="slot-summary">{entry.data.summary}</span>
								<span class="slot-meta">
									<span class="slot-tags">
										{entry.data.tags.map((tag: string) => (
											<span class="chip">{tag}</span>
										))}
									</span>
									<span class="slot-date hud-label">
										{entry.data.date.toLocaleDateString('en-US', {
											month: 'short',
											year: 'numeric',
										})}
									</span>
								</span>
							</span>

							<span class="slot-load hud-label" aria-hidden="true">
								view <span class="slot-arrow">→</span>
							</span>
						</a>
					</li>
				))
			}
		</ol>
	</section>
</BaseLayout>

<style>
	.section {
		padding: var(--space-16) 0 var(--space-12);
	}

	.page-head {
		display: flex;
		flex-direction: column;
		gap: 0.55rem;
		margin-bottom: var(--space-10);
	}

	.slots {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	/* ── Save slot ── */
	.slot {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: var(--space-6);
		padding: 1.2rem 1.4rem;
		transition:
			transform var(--transition-bounce),
			border-color var(--transition-fast),
			box-shadow var(--transition-bounce);
	}

	.slot:hover,
	.slot:focus-visible {
		transform: translateY(-1px);
		border-color: color-mix(in oklab, var(--accent) 50%, var(--line-strong));
		box-shadow: 0 calc(var(--chunk) + 3px) 0 var(--chunk-shadow), var(--shadow-soft);
	}

	.slot-main {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		min-width: 0;
	}

	.slot-top {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		flex-wrap: wrap;
	}

	.slot-title {
		font-family: var(--font-display);
		font-size: clamp(1.2rem, 1rem + 0.9vw, 1.7rem);
		font-weight: 550;
		line-height: 1.05;
		color: var(--ink-strong);
		transition: color var(--transition-fast);
	}

	.slot:hover .slot-title {
		color: var(--accent-strong);
	}

	.slot-summary {
		color: var(--muted);
		font-size: 0.92rem;
		line-height: 1.55;
		max-width: 62ch;
	}

	.slot-meta {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
		margin-top: 0.2rem;
	}

	.slot-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem;
	}

	.slot-date {
		color: var(--muted-soft);
	}

	.slot-load {
		color: var(--muted-soft);
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		transition: color var(--transition-fast);
	}

	.slot-arrow {
		color: var(--accent);
		opacity: 0;
		transform: translateX(-5px);
		transition: opacity var(--transition-fast), transform var(--transition-bounce);
	}

	.slot:hover .slot-load {
		color: var(--accent-strong);
	}

	.slot:hover .slot-arrow {
		opacity: 1;
		transform: translateX(0);
	}

	/* ── Responsive ── */
	@media (max-width: 760px) {
		.slot {
			grid-template-columns: 1fr;
			gap: 0.75rem;
			padding: 1.1rem 1.15rem;
		}

		.slot-load {
			display: none;
		}
	}
</style>
